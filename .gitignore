# Scratch
*.tmp
tmp/
scratch/

# NOTE: sources/whats-in-a-word/raw/ is deliberately NOT ignored.
# Those 374 articles are the evidence base every entry cites, and the repo is
# private, so they are stored, not published. If this repo is ever made public,
# or an entries-only mirror is split out, that directory must be excluded first:
# it is Rabbi Reuven Chaim Klein's and Ohr Somayach's copyright, held here for
# research use only.

# Generated site. Rebuilt by `python tools/build_site.py`, so it is output, not
# source, and committing it would bury real changes under 342 regenerated pages.
# It is also what gets deployed, and deploying only this folder is what keeps
# the copyrighted corpus off the web.
site/
dist/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
